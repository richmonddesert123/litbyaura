# --- Core ---
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000
JWT_SECRET=change-this-to-a-long-random-string
CURRENCY=GHS
CURRENCY_SYMBOL=GH₵

# DB_PATH: where the SQLite file lives. Leave blank for local dev (defaults
# to litbyaura.db next to the project root). On Render (or any host with an
# ephemeral filesystem), set this to a path on your attached persistent disk
# - e.g. /var/data/litbyaura.db - or every deploy/restart wipes your data.
DB_PATH=

# --- Admin bootstrap ---
# You no longer need to set these to create your first admin - visit /admin
# and a "Create admin account" form appears automatically as long as zero
# admin accounts exist yet. That form disables itself forever the moment one
# admin is created. ADMIN_EMAIL/ADMIN_PASSWORD below are kept only as an
# optional CLI alternative (`npm run seed`) for scripted/automated deploys.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Payments: Cash on Delivery (default, always on) ---
# COD has no credentials and no ENABLED flag — it is the guaranteed fallback
# so the store can always take orders even if every other provider is off.

# --- Payments: Paystack ---
# Two independent switches on purpose:
#   *_SECRET_KEY  -> credentials, lets you test the integration privately
#   *_ENABLED     -> customer-facing visibility, enforced on frontend AND backend
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_ENABLED=false

# --- Payments: Hubtel (mobile money) ---
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_ENABLED=false

# --- Email ---
# console provider just logs emails to stdout - safe default for local dev
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="LitByAura <orders@litbyaura.com>"
